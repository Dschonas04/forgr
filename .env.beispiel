# Kopieren nach .env und ausfüllen. .env gehört nicht ins Repository.
DB_KENNWORT=
# Webhooks sind aus, solange kein Ziel freigegeben ist (Schema, Host, Port):
# FORGR_WEBHOOK_ZIELE=https://n8n.example:5678
# FORGR_WEBHOOK_GEHEIMNIS=
# Spiegel alle zehn Minuten, ohne Überschreiben und ohne Löschen. Mit Komma:
# FORGR_SPIEGEL=besitzer/repo push https://github.com/name/repo.git
# FORGR_SPIEGEL_HOST=github.com
# FORGR_SPIEGEL_TOKEN=
# Notausgang, falls man sich ausgesperrt hat:
# FORGR_SSO_AUS=1
# Wer verwaltet, zusätzlich zum ersten Konto aus der Einrichtung. Bei SSO nötig:
# FORGR_ADMIN=oidc:https://anbieter.example/realms/name|<sub>
